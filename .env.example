# URL PostgreSQL du projet Supabase (Dashboard > Connect > Connection string).
# Ne jamais exposer cette URL dans le frontend ni la committer.
DATABASE_URL=postgresql://postgres:[MOT_DE_PASSE]@[HOTE]:5432/postgres?sslmode=require

# Utilisee uniquement lorsque DATABASE_URL n'est pas defini.
# DB_PATH=data/eventbridge.sqlite