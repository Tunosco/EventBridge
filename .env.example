# Copy this file to .env and replace every placeholder with your own values.
# Never commit .env or expose SUPABASE_SECRET_KEY in the frontend.

# Shared Session Pooler connection. URL-encode the PostgreSQL password.
DATABASE_URL=postgresql://postgres.voycqmxzakxeedrofimk:YOUR_DATABASE_PASSWORD_URL_ENCODED@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Download the database root CA from Supabase > Database > Settings > SSL Configuration.
SUPABASE_DB_SSL_CA_PATH=./prod-ca-2021.crt

# Supabase project settings
SUPABASE_URL=https://voycqmxzakxeedrofimk.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_YOUR_KEY

# Must be listed in Supabase Authentication > URL Configuration
SUPABASE_EMAIL_REDIRECT_URL=http://localhost:5173/
